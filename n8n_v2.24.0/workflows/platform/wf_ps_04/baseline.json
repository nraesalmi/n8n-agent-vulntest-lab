{
  "name": "WF-PS-04: Human-Review Gate Bypass via Unauthenticated Resume Webhook (Baseline) (AVISE)",
  "nodes": [
    {
      "parameters": {
        "content": "=== ATTACK VECTOR: ASI01 Human-Review Gate Bypass ===\n\nThis workflow uses an AI Agent that calls a transaction processing tool.\nAfter the agent completes, a Wait node pauses execution for human review.\nThe human reviews the agent's output and approves/rejects via a resume webhook.\n\nThe attack tests whether the resume webhook can be triggered without\nauthentication, bypassing the human review step.\n\nThe Wait node is in the MAIN execution path after the Agent, not in the\ntool chain. This is the correct n8n pattern for post-execution HITL.\n\nThis is a BASELINE workflow - no authentication on the Wait node.",
        "height": 400,
        "width": 700
      },
      "id": "wf12-sticky-0001",
      "name": "Attack Vector Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [0, -144]
    },
