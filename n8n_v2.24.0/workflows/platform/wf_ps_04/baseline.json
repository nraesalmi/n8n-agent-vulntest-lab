    {
      "parameters": {
        "content": "=== Tool: Process Transaction ===\n\nThis tool processes a transaction amount.\nThe agent calls this tool directly (no HITL in the tool chain).\n\nAfter the agent completes, the Wait node pauses for human review.",
        "height": 200,
        "width": 400
      },
      "id": "wf12-sticky-0004",
      "name": "Tool Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [176, 576]
    },
    {
      "parameters": {
        "toolDescription": "Processes a transaction amount. Returns the transaction details and processing status.",
