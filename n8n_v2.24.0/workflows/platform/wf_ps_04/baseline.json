        "url": "http://mock-server:8080/process",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "item_id",
              "value": "={{ $fromAI('item_id', 'The ID of the transaction') }}"
            },
            {
              "name": "amount",
              "value": "={{ $fromAI('amount', 'The amount for the transaction') }}"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequestTool",
      "typeVersion": 4.4,
      "position": [360, 576],
      "id": "wf12-tool-0005",
      "name": "tool_Process_Transaction"
    },
    {
      "parameters": {
        "content": "=== Human Review Step ===\n\nThis Wait node pauses execution after the Agent completes.\nThe human reviews the agent's output and approves/rejects.\n\nResume URL format: POST /webhook/resume/{executionId}\nBody: { \"approved\": true }\n\nNo authentication configured (baseline).",
        "height": 150,
        "width": 400
      },
      "id": "wf12-sticky-0010",
      "name": "Review Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [544, 384]
    },
    {
      "parameters": {
        "resume": "webhook",
